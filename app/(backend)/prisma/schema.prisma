generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* =======================
   ENUMS
======================= */

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COOKING
  DELIVERED
  CANCELLED
}

enum EventStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/* =======================
   USER
======================= */

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  orders         Order[]
  menuReviews    MenuItemReview[]
  packageReviews PackageReview[]
  hamperReviews  HamperReview[]
  eventReviews   EventReview[]
}

/* =======================
   CATEGORY & MENU ITEMS
======================= */

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  items MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  available   Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images        MenuItemImage[]
  orderItems   OrderItem[]
  packageItems PackageItem[]
  hamperItems  HamperItem[]
  reviews      MenuItemReview[]

  createdAt DateTime @default(now())
}

model MenuItemImage {
  id         String   @id @default(uuid())
  url        String
  publicId   String
  menuItemId String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/* =======================
   ORDERS
======================= */

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())

  user          User           @relation(fields: [userId], references: [id])
  items         OrderItem[]
  orderPackages OrderPackage[]
  orderHampers  OrderHamper[]
}

model OrderItem {
  id       String   @id @default(uuid())
  orderId  String
  menuId   String
  quantity Int

  order Order    @relation(fields: [orderId], references: [id])
  menu  MenuItem @relation(fields: [menuId], references: [id])
}

model OrderPackage {
  id        String @id @default(uuid())
  orderId   String
  packageId String
  quantity  Int    @default(1)
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  package Package @relation(fields: [packageId], references: [id])
}

model OrderHamper {
  id       String @id @default(uuid())
  orderId  String
  hamperId String
  quantity Int    @default(1)
  price    Float

  order  Order  @relation(fields: [orderId], references: [id])
  hamper Hamper @relation(fields: [hamperId], references: [id])
}

/* =======================
   PACKAGES (NO EVENTS)
======================= */

model Package {
  id            String   @id @default(uuid())
  name          String
  description   String?

  originalPrice Float
  discountType  DiscountType?
  discountValue Float?
  finalPrice    Float

  image         String?
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())

  items         PackageItem[]
  orderPackages OrderPackage[]
  reviews       PackageReview[]
}

model PackageItem {
  id         String @id @default(uuid())
  packageId  String
  menuItemId String
  quantity   Int    @default(1)

  package  Package  @relation(fields: [packageId], references: [id],onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

/* =======================
   EVENTS (ADMIN CREATED)
======================= */

model Event {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      EventStatus @default(PENDING)
  createdAt DateTime @default(now())

  hampers Hamper[]
  reviews EventReview[]
}

/* =======================
   HAMPERS (EVENT-BASED)
======================= */

model Hamper {
  id            String   @id @default(uuid())
  name          String
  description   String?

  originalPrice Float
  discountType  DiscountType?
  discountValue Float?
  finalPrice    Float

  image         String?
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  items        HamperItem[]
  orderHampers OrderHamper[]
  reviews      HamperReview[]
}

model HamperItem {
  id         String @id @default(uuid())
  hamperId   String
  menuItemId String
  quantity   Int    @default(1)

  hamper   Hamper   @relation(fields: [hamperId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

/* =======================
   REVIEWS
======================= */

model MenuItemReview {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
}

model PackageReview {
  id         String   @id @default(uuid())
  userId     String
  packageId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId])
}

model HamperReview {
  id         String   @id @default(uuid())
  userId     String
  hamperId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  hamper Hamper @relation(fields: [hamperId], references: [id])

  @@unique([userId, hamperId])
}

model EventReview {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}
