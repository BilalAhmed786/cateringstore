generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =======================
 * ENUMS
 * =======================
 */

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COOKING
  DELIVERED
  CANCELLED
}

enum EventStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

/**
 * =======================
 * USER
 * =======================
 */

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())

  orders         Order[]
  menuReviews    MenuItemReview[]
  packageReviews PackageReview[]
  hamperReviews  HamperReview[]
  eventReviews   EventReview[]
}

/**
 * =======================
 * CATEGORY & MENU ITEMS
 * =======================
 */

model MenuCategory {
  id        String   @id @default(uuid())
  name      String
  image     String?
  publicId  String?
  createdAt DateTime @default(now())

  items MenuItem[]
}

model MenuItem {
  id          String  @id @default(uuid())
  title       String
  description String?
  price       Float
  available   Boolean @default(true)

  categoryId   String
  category     MenuCategory     @relation(fields: [categoryId], references: [id])
  images       ItemImage[]
  orderItems   OrderItem[]
  packageItems PackageItem[]
  hamperItems  HamperItem[]
  reviews      MenuItemReview[]
  eventLinks   EventMenuItem[]
  createdAt    DateTime         @default(now())
}

model ItemImage {
  id         String @id @default(uuid())
  url        String
  publicId   String
  menuItemId String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

/**
 * =======================
 * ORDERS
 * =======================
 */

model Order {
  id        String      @id @default(uuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Float
  createdAt DateTime    @default(now())

  user          User           @relation(fields: [userId], references: [id])
  items         OrderItem[]
  orderPackages OrderPackage[]
  orderHampers  OrderHamper[]
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  menuId   String
  quantity Int

  order Order    @relation(fields: [orderId], references: [id])
  menu  MenuItem @relation(fields: [menuId], references: [id])
}

model OrderPackage {
  id        String @id @default(uuid())
  orderId   String
  packageId String
  quantity  Int    @default(1)
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  package Package @relation(fields: [packageId], references: [id])
}

model OrderHamper {
  id       String @id @default(uuid())
  orderId  String
  hamperId String
  quantity Int    @default(1)
  price    Float

  order  Order  @relation(fields: [orderId], references: [id])
  hamper Hamper @relation(fields: [hamperId], references: [id])
}

/**
 * =======================
 * PACKAGES (NO EVENTS)
 * =======================
 */

model Package {
  id          String  @id @default(uuid())
  name        String
  description String?

  originalPrice Float
  discountType  DiscountType?
  discountValue Float?
  finalPrice    Float

  image     String?
  publicId  String?
  available Boolean  @default(true)
  createdAt DateTime @default(now())

  items         PackageItem[]
  orderPackages OrderPackage[]
  reviews       PackageReview[]
  eventLinks    EventPackage[]
}

model PackageItem {
  id         String @id @default(uuid())
  packageId  String
  menuItemId String
  quantity   Int    @default(1)

  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

/**
 * =======================
 * EVENTS (ADMIN CREATED)
 * =======================
 */

model EventCategory {
  id        String   @id @default(uuid())
  name      String
  image     String?
  publicId  String?
  createdAt DateTime @default(now())

  items Event[]
}

model Event {
  id             String          @id @default(uuid())
  name           String
  description    String?
  image          String?
  publicId       String?

  originalPrice  Float           @default(0)
  discountType   DiscountType?
  discountValue  Float?
  finalPrice     Float           @default(0)

  available      Boolean         @default(true)
  categoryId     String
  category       EventCategory   @relation(fields: [categoryId], references: [id])
  createdAt      DateTime        @default(now())

  menuItems      EventMenuItem[]
  packages       EventPackage[]
  reviews        EventReview[]
}
model EventMenuItem {
  id         String @id @default(uuid())
  eventId    String
  menuItemId String
  quantity   Int    @default(1)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([eventId, menuItemId])
}

model EventPackage {
  id        String @id @default(uuid())
  eventId   String
  packageId String
  quantity  Int    @default(1)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@unique([eventId, packageId])
}

/**
 * =======================
 * HAMPERS (EVENT-BASED)
 * =======================
 */
model HamperCategory {
  id        String   @id @default(uuid())
  name      String
  image     String?
  publicId  String?
  createdAt DateTime @default(now())
  items     Hamper[]
}

model Hamper {
  id            String         @id @default(uuid())
  name          String
  description   String?
  originalPrice Float
  discountType  DiscountType?
  discountValue Float?
  finalPrice    Float
  image         String?
  publicId      String?
  categoryId    String
  category      HamperCategory @relation(fields: [categoryId], references: [id])
  available     Boolean        @default(true)
  createdAt     DateTime       @default(now())

  items        HamperItem[]
  orderHampers OrderHamper[]
  reviews      HamperReview[]
}

model HamperItem {
  id         String @id @default(uuid())
  hamperId   String
  menuItemId String
  quantity   Int    @default(1)

  hamper   Hamper   @relation(fields: [hamperId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}

/**
 * =======================
 * REVIEWS
 * =======================
 */

model MenuItemReview {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
}

model PackageReview {
  id        String   @id @default(uuid())
  userId    String
  packageId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  package Package @relation(fields: [packageId], references: [id])

  @@unique([userId, packageId])
}

model HamperReview {
  id        String   @id @default(uuid())
  userId    String
  hamperId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  hamper Hamper @relation(fields: [hamperId], references: [id])

  @@unique([userId, hamperId])
}

model EventReview {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}
